    end)
    pcall(function()
        if previous.InputConnection then previous.InputConnection:Disconnect() end
        if previous.InputEndedConnection then previous.InputEndedConnection:Disconnect() end
    end)
    pcall(function()
        if previous.Indicator then previous.Indicator:Remove() end
        if previous.TargetBox then previous.TargetBox:Remove() end
    end)
end
